*/
				});
				$(window).resize(function(){
					$('table.table:not(.no)').dataTable();
				});
				$("form.no").submit(function(){ return false; });
				
				var options_tipo="<option value='17'>Producto – Proveedor</option><option value='21'>Opn – Cambiado</option><option value='23'>Opn – Dañado</option><option value='19'>Opn – Faltante</option><option value='22'>Opn – Mal acomodo</option><option value='24'>Opn – Mal declarado</option><option value='20'>Opn – No etiquetado/ identificado</option><option value='18'>Opn – Sobrante</option><option value='12'>Producto – Cambiado</option><option value='13'>Producto – Defectuoso</option><option value='16'>Producto – Error de Envio</option><option value='11'>Producto – Faltante</option><option value='14'>Producto – Incompleto</option><option value='15'>Producto – Mal Identificado</option><option value='10'>Producto – Sobrante</option><option value='9'>Producto – Dañado</option><option value='25'>Producto – Dañado CMX</option><option value='26'>Producto – Faltante CMX</option><option value='27'>TI – Problemas con Moving</option><option value='28'>TI – Solicitud de Desarrollo en Moving</option><option value='6'>TI – Daño de Equipo / Celular</option><option value='1'>TI – Problemas con equipos</option><option value='3'>TI – Problemas con licencias</option><option value='2'>TI – Problemas con Sistemas o Aplicaciones</option>";
					
				

				$(".ticket_popover").popover({
					html: true, 
					content: function() {
						return ""+$('<div>').attr('id','popover-content').addClass('hide').append(
							$('<form>').addClass('form-registro-clientes').attr({'method':'post','enctype':'multipart/form-data'}).append(
								$('<div>').addClass('row')
									.append(
										$('<div>').addClass('col-xs-12')
											.append( $('<input>').attr({type:'hidden',name:'erp_token'}).val(token) )
											.append( 
												$('<select>').attr({name:'id_tickets_tipo'}).addClass('form-control').html(options_tipo)
											)
									)
									.append(
										$('<div>').addClass('col-xs-12').attr({style:'margin:5px 0px 5px 0px;'})
											.append( $('<input>').attr({type:'text',name:'asunto',placeholder:'Asunto'}).addClass('form-control') )
									)
									.append(
										$('<div>').addClass('col-xs-12')
											.append( $('<textarea>').attr({name:'descripcion',placeholder:'Descripción',rows:"10",cols:"40"}).addClass('form-control') )
									)
									.append(
										$('<div>').addClass('col-xs-12 factura_cont').attr({style:'margin:10px 0px 15px 0px;'})
											.append( 
												$('<select>').attr({name:'factura',id:'factura_ticket','data-placeholder':'Buscar la Factura #'}).addClass('form-control')
													.append( $('<option>').attr({diabled:true, selected:true,value:0}).html('Buscar Factura') )
											)
									)
									.append(
										$('<div>').addClass('col-xs-12')
											.append( $('<label>').html("Subir Archivo") )
										  .append( $('<input>').attr({type:'file',style:'margin-bottom:5px;',name:'files'}).addClass('form-control') )
									)
									.append(
										$('<div>').addClass('col-xs-12').attr('style','padding-top: 5px;')
											.append( $('<button>').attr({type:'button',style:'width: 100%;'}).addClass('btn btn-success btnx btn-registrar-ticket').html(' Registrar ') )
									)
							)
						).html();
						
					}
				});
				var facturitas=[];
				$('.ticket_popover').on('shown.bs.popover', function () {
					$('#factura_ticket').select2({
						dropdownParent: $('.popover-content'),
						ajax: {
							url: baseurl+"/tickets/obtener_facturas/",
							data: function (params) {
								var queryParameters = {
									buscar: params.term
								}
								return queryParameters;
							},
							dataType: 'json',
							delay:1000,
							processResults: function (data) {
								$(data.rest).each( function(k,v){
									facturitas[v.DocNum]=v;
								});
								return {
									results: data.items
								};
							},
							cache:true
						},
						placeholder: 'Buscando Factura...',
						minimumInputLength: 3
					});
				});
				
				$(document).on('click', '.btn-registrar-ticket', function() {
					NProgress.set(0.5);
					var form = $(this).closest('form')[0];
					var formData = new FormData(form);

					$.ajax({
						method: "POST",
						url: baseurl + "tickets/enviar_ticket",
						data: formData,
						contentType: false,
						processData: false,
					})
					.done(function(data) {
						if (data.status == 'ok') {
							//console.log("Respuesta del servidor:", data);
							toastr.success(data.msj);
							$(".ticket_popover").popover('hide')
						} else {
							toastr.error(data.msj);
						}
						NProgress.set(1);
					});
					
				});
				
									var iter_loguiacion=setInterval(checar_loguiacion,300000);
					function checar_loguiacion(){
						$.get( "./acceso/vivo", function( data ) { if( typeof data.vivo !== 'undefined' && data.vivo == false ){ $('#cerrado').show(); clearInterval(iter_loguiacion); } });
					}
							});
