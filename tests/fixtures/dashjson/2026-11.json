				<script type='text/javascript'>
			$(function(){
				function tiempo(){
					var now = new Date(); 
					var hour = now.getHours();
					var minute = now.getMinutes();
					hour = ( hour < 10 )? "0"+hour : hour;
					minute = ( minute < 10 )? "0"+minute : minute;
					$('#reloj').html(hour +':'+ minute);
				}
				tiempo();
				setInterval(function(){ tiempo(); },60000);
				//App.datatables();
				// NProgress.set(0.0);
				$('table.table:not(.no)').each(function(){
					var tabla=$(this);
					var ajax=tabla.data('ajax');
					var columns=[];
					tabla.find('>thead>tr>th').each(function(){
						columns.push({'data': $(this).data('campos'),'tipo': $(this).data('tipo'),'name': $(this).data('valor'), 'searchable': ( $(this).data('buscar')==undefined?true:$(this).data('buscar') ) });
					});
					$(tabla).dataTable({
					"lengthMenu": [[10, 25, 50,100,500,1000, -1], [10, 25, 50,100,500,1000, "Todo"]],
					columnDefs: [ { orderable: false, targets: [ $(this).data('noorden')==undefined?null:$(this).data('noorden') ] } ],
					"order":  [[ $(this).data('orden')==undefined?0:$(this).data('orden') , $(this).data('tipoorden')==undefined?"desc":$(this).data('tipoorden') ]],
					pageLength: ($(this).data('paginas')==undefined?10:$(this).data('paginas')),
					"autoWidth": false,
					responsive: ($(this).data('responsive')==undefined?true:$(this).data('responsive')),
					"processing": (ajax!=undefined?true:false),
					"serverSide": (ajax!=undefined?true:false),
					"sServerMethod":($(this).data('ajaxmetodo')==undefined?'GET':$(this).data('ajaxmetodo')),
					"ajax": (ajax!=undefined? {
            "url": (ajax!=undefined?ajax:null),
            "data": function ( d ) {
	            d.erp_token= token;
                d.myKey = "myValue";
            }
					}:null),
					"columns": (columns!=undefined?columns:null),
					initComplete: function(settings, json) {
						$('.tool').tooltip();
						$($('table.table:not(.no) input[name="fila"]')[0]).prop('checked',true);
					},
					"language": {
						"emptyTable": "..."
					},
					footerCallback: function(row, data, start, end, display) {
						if( $(this).data('sumf')!=undefined ){
							var api = this.api();
							var intVal = function ( i ) {
								return typeof i === 'string' ? i.replace(/[\$,]/g, '')*1 : typeof i === 'number' ? i : 0;
							};
							// Total over all pages
							total = api
									.column( $(this).data('sumf') )
									.data()
									.reduce( function (a, b) {
											return intVal(a) + intVal(b);
									}, 0 );

							// Total over this page
							visibles = api
									.column( $(this).data('sumf'), { page: 'current'} )
									.data()
									.reduce( function (a, b) {
											return intVal(a) + intVal(b);
									}, 0 );
							
							// Update footer
							/*
							$( api.column( $(this).data('sumf') ).footer() ).html( 
								'<i style="font-size:11px;">Pagina:</i> '+ $.number(visibles,2)+'<br>'+
								'<i style="font-size:11px;">Total: </i>'+ $.number(total,2)
							);*/
							$('#sum_pag').html($.number(visibles,2));
							$('#sum_tot').html($.number(total,2));
						}
					}
					});
				});
				$('table.table:not(.no)').on( 'processing.dt', function ( e, settings, processing ) {
					NProgress.set(1);
				}).dataTable();
				$(document).on('keyup','input[type="search"]',function(){
