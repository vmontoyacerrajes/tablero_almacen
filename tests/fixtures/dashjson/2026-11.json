				$('.busqueda').keyup(function(i){
					if(i.keyCode ==13){
						var url=window.location.href.split('?');
						window.location=url[0]+"?busqueda="+ $(this).val();
					}
				});
				$('.solo_mayusculas').keyup(function(i){
					if(i.keyCode!=9 && i.keyCode!=16 &&  i.keyCode!=18 && i.keyCode!=37 && i.keyCode!=38 && i.keyCode!=39 && i.keyCode!=91 && i.keyCode!=undefined){
						$(this).val( $(this).val().toUpperCase() );
					}
				});
				$(document).on('click','.confirmar',function(e){
					e.preventDefault();
					var emoji_tipo=$(this).data('tipo');
					var pregunta=$(this).data('pregunta');
					var descripcion=$(this).data('descripcion');
					var url=$(this).attr('href');
					var form=$(this).closest('form');
					swal({
					title: "<div class='emoji "+emoji_tipo+"'></div>"+pregunta,
					text: descripcion,
					showCancelButton: true,
					confirmButtonColor: "#DD6B55",
					confirmButtonText: "Si",
					cancelButtonText: "No",
					closeOnConfirm: false,
					closeOnCancel: true,
					html:true
					}, function(isConfirm){
						if( isConfirm ){
							if(url!=undefined){
								window.location=url;
							}else{
								$(form).submit();
							}
						}
					});
				});
				var ele_actual=null
				$('.key').each(function(){
					var ele=$(this);
					var key=$(this).data('key');
					var es_select=false;
					if( ele.hasClass('select-chosen') ){
						es_select=true;
					}
					
					$(document).bind('keydown', key , function assets(e) {
						if(es_select){
							$(ele).trigger('chosen:open');
						}else{
							$(ele).focus().click();
						}
						ele_actual=ele;
					});
				});
				$(document).keypress(function(e){
/*
