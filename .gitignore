cat > .gitignore <<'EOF'
# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.env
.env.*
.pytest_cache/
.mypy_cache/

# Logs
*.log

# Node / React
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
coverage/

# Docker
*.pid

# App caches / temp
.cache/
EOF